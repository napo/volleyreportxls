{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VolleyReport",
  "version": "0.2.1",
  "identifier": "it.napolitano.volleyreport",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "VolleyReport",
        "width": 1280,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "category": "Sports",
    "shortDescription": "Dalla carta al report della gara di pallavolo",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGNUI4Q0YxOTRFQUMyMEUKUldRT3d1cVU4WXhienp3TGhnWm9ZOFVmR1huT1BacTFrMmY2S0M0UTBkc1dGdDQxa3o5VnBOckEK",
      "endpoints": [
        "https://github.com/napo/volleyreportxls/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
